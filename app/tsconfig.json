{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "svelte"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "electron.vite.config.ts", "scripts/**/*.ts", "vitest.config.ts"]
}
