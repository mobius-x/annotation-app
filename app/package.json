{
  "name": "annotation-app",
  "productName": "Annotator",
  "version": "1.0.0",
  "description": "Portable desktop application for annotating Russian-language text",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "npm run check:contrast && electron-vite build",
    "check:contrast": "vitest run src/shared/settings.test.ts",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "start": "electron-vite preview",
    "package:win:dir": "electron-builder --win dir"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "chardet": "2.2.0",
    "chokidar": "6.0.0",
    "codemirror": "6.0.2",
    "docx": "9.13.0",
    "dompurify": "3.4.17",
    "fflate": "0.8.3",
    "iconv-lite": "0.7.3",
    "jsonc-parser": "3.3.1",
    "markdown-it": "15.0.3",
    "sql.js": "1.15.1",
    "svelte": "5.57.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.2",
    "@types/sql.js": "1.4.11",
    "electron": "44.9.2",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "fast-check": "4.10.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "local.annotator.desktop",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    }
  }
}
